# ==============================================================================
# .gitignore complet - Python, Ollama, WSL & Environnements de développement
# ==============================================================================

config.properties
mapping_central.csv
SampleDir/
SampleDir_Anonymise/
OC1_Ex1/
OC1_Ex1_Anonymise/

# ------------------------------------------------------------------------------
# 1. Environnements virtuels Python
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 2. Fichiers compilés et caches Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Logs, processus et fichiers d'exécution locale (Ollama, scripts)
# ------------------------------------------------------------------------------
*.log
ollama.log
*.pid
*.seed
*.lock

# ------------------------------------------------------------------------------
# 4. Modèles d'IA locaux et gros fichiers de poids / checkpoints
# ------------------------------------------------------------------------------
*.bin
*.onnx
*.pt
*.pth
*.safetensors
*.gguf
.ollama/
models/
checkpoints/

# ------------------------------------------------------------------------------
# 5. Fichiers de configuration sensibles et variables d'environnement
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json

# ------------------------------------------------------------------------------
# 6. Outils de test, couverture et typage
# ------------------------------------------------------------------------------
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 7. Jupyter Notebooks
# ------------------------------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# 8. Éditeurs et IDEs
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / JetBrains
.idea/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-z]
*.un~
Session.vim
.netrwhist
*~
\#*\#
/.emacs.d/

# ------------------------------------------------------------------------------
# 9. Fichiers système d'exploitation (Windows, Linux, macOS)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon\r
._*
.Spotlight-V100
.Trashes

# Linux / WSL
*~
.fuse_hidden*
.directory
.Trash-*
